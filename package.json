{
  "name": "vkui-audiopad",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "./build.sh",
    "build:common": "npm run build -w @vk-audiopad/common",
    "check": "node scripts/validate-package-versions.mjs && npm run build -w @vk-audiopad/common && npm run -ws --if-present typecheck && npm run -ws --if-present lint",
    "test": "vitest run",
    "eslint:fix": "npm run -ws --if-present eslint:fix",
    "verify:build": "node scripts/verify-build-output.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/firefox-webext-browser": "143.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "neostandard": "0.14.1",
    "semver": "7.8.5",
    "vite": "6.4.5",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
