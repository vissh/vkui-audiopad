{
  "name": "vkui-audiopad",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.22.2 <25",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "preinstall": "node scripts/doctor.mjs --runtime-only",
    "doctor": "node scripts/doctor.mjs",
    "mcp:sync": "node scripts/mcp-config.mjs --write",
    "mcp:check": "node scripts/mcp-config.mjs --check",
    "build": "./build.sh",
    "build:common": "npm run build -w @vk-audiopad/common",
    "build:profile": "npm run build:common && npm run build -w @vk-audiopad/front -- --mode profile",
    "check": "npm run doctor && npm run docs:check && node scripts/validate-package-versions.mjs && npm run build -w @vk-audiopad/common && npm run --workspaces typecheck && npm run typecheck:tests && npm run --workspaces lint && npm run lint:tooling",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "lint:tooling": "eslint scripts tests vitest.config.mts eslint.config.mjs",
    "test": "vitest run",
    "eslint:fix": "npm run --workspaces eslint:fix",
    "verify:build": "node scripts/verify-build-output.mjs",
    "release:package": "node scripts/package-release.mjs",
    "docs:check": "node scripts/check-documentation.mjs",
    "smoke:firefox": "node scripts/smoke-firefox.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@testing-library/react": "16.3.3",
    "@types/chrome": "0.3.7",
    "@types/firefox-webext-browser": "143.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "github-slugger": "2.0.0",
    "jsdom": "30.1.3",
    "mdast-util-from-markdown": "2.1.0",
    "neostandard": "0.14.1",
    "semver": "7.8.5",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "overrides": {
    "minimatch@^10": "11.0.1"
  }
}
