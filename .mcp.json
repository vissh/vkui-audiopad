{
  "mcpServers": {
    "vkui": {
      "command": "npx",
      "args": [
        "-y",
        "@vkontakte/vkui-mcp@1.1.0"
      ],
      "env": {
        "VKUI_VERSION": "8.4.3"
      }
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.12.0",
        "--categoryExtensions",
        "--no-usage-statistics"
      ]
    },
    "firefox-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "@mozilla/firefox-devtools-mcp-moz@0.10.7",
        "--tools",
        "pages",
        "snapshot",
        "input",
        "network",
        "console",
        "screenshot",
        "utilities",
        "management",
        "webextension",
        "script",
        "privileged",
        "--auto-profile",
        "--viewport",
        "780x600"
      ],
      "env": {
        "MOZ_REMOTE_ALLOW_SYSTEM_ACCESS": "1"
      }
    }
  }
}
