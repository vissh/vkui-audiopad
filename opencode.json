{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [".agents/skills"]
  },
  "mcp": {
    "vkui": {
      "type": "local",
      "command": ["npx", "-y", "@vkontakte/vkui-mcp@1.1.0"],
      "enabled": true,
      "environment": {
        "VKUI_VERSION": "7.11.7"
      }
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "chrome-devtools-mcp@1.12.0", "--categoryExtensions"],
      "enabled": true
    }
  }
}
